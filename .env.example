# Copy to .env (git-ignored) or source ~/.config/slate/keys.env. Never commit real keys.
DEPLOYER_PRIVATE_KEY=
SIGNER_1_PRIVATE_KEY=
SIGNER_2_PRIVATE_KEY=
SIGNER_3_PRIVATE_KEY=

RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
RH_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Only needed for Arbiscan verification (prompt C3)
ARBISCAN_API_KEY=

# Publisher: Postgres (Neon) for the accuracy history. Set on the Railway publisher service only.
DATABASE_URL=
